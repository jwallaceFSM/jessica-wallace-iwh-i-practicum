//- ** This is a sample of a pug template and how it uses the data passed to it from index.js.

doctype html
html 
     head 
         title= `${title}`
         meta(name="viewport" content="width=device-width, initial-scale=1")
         link(rel="stylesheet", href="/css/style.css")
     body    
         h1 Texas Native Plants
         .cards 
             each plant in data
                 .card 
                     h2.card__name #{plant.properties.name}  
                     p.card__details strong ZONE: #{plant.properties.zone}
                     p.card__details strong SUNLIGHT: #{plant.properties.sunlight}