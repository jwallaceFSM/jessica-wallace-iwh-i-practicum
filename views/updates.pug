//- ** This is a sample of a pug template and how it uses the data passed to it from index.js.

doctype html
html 
     head 
         title= `${title}`
         meta(name="viewport" content="width=device-width, initial-scale=1")
         link(rel="stylesheet", href="/css/style.css")
     body    
         h1 Texas Native Plants
         a.button(href="/") Return to the homepage
            table
                thead
                    tr
                        th Name 
                        th Zone 
                        th Sunlight 
                tbody
                    each plant in data
                        tr
                            td #{plant.properties.name}
                            td #{plant.properties.zone}
                            td #{plant.properties.sunlight}
